<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>GenericKanban</AssemblyName>
    <RootNamespace>GenericKanban</RootNamespace>
    <Optimize>true</Optimize>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!-- Exclude Template folder from compilation -->
  <ItemGroup>
    <Compile Remove="Template\**\*" />
    <None    Remove="Template\**\*" />
    <Content Remove="Template\**\*" />
    <EmbeddedResource Remove="Template\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="Newtonsoft.Json"        Version="13.0.3" />
  </ItemGroup>

  <!-- Copy wwwroot to output directory so the DLL can find it at runtime -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- â”€â”€ Post-build: copy manifest â†’ output, then deploy to Clarion\ â”€â”€â”€â”€ -->

  <Target Name="CreateClarionFolders" BeforeTargets="CopyToClarion">
    <MakeDir Directories="$(ProjectDir)Clarion\accessory\bin"                    Condition="!Exists('$(ProjectDir)Clarion\accessory\bin')" />
    <MakeDir Directories="$(ProjectDir)Clarion\accessory\bin\GenericKanban"      Condition="!Exists('$(ProjectDir)Clarion\accessory\bin\GenericKanban')" />
    <MakeDir Directories="$(ProjectDir)Clarion\accessory\resources"              Condition="!Exists('$(ProjectDir)Clarion\accessory\resources')" />
  </Target>

  <Target Name="CopyManifest" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)$(AssemblyName).manifest"
          DestinationFiles="$(OutputPath)$(AssemblyName).manifest"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)$(AssemblyName).manifest')" />
  </Target>

  <Target Name="CopyToClarion" AfterTargets="CopyManifest">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(ProjectDir)Clarion\accessory\bin\$(AssemblyName).dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).manifest"
          DestinationFiles="$(ProjectDir)Clarion\accessory\bin\$(AssemblyName).manifest"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)$(AssemblyName).manifest')" />
    <Message Text="Deployed to $(ProjectDir)Clarion\accessory\" Importance="high" />
  </Target>

  <Target Name="CopyDependenciesToClarion" AfterTargets="CopyToClarion">
    <!-- Managed dependencies go into a private subfolder to avoid version
         conflicts with other COM controls that ship the same assemblies.
         AssemblyResolve in GenericKanbanControl loads them from here. -->
    <ItemGroup>
      <ManagedDeps Include="$(OutputPath)*.dll"
                   Exclude="$(OutputPath)$(AssemblyName).dll;$(OutputPath)WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ManagedDeps)"
          DestinationFolder="$(ProjectDir)Clarion\accessory\bin\GenericKanban"
          SkipUnchangedFiles="true" />
    <!-- Native WebView2Loader.dll stays in the root bin folder -->
    <Copy SourceFiles="$(OutputPath)runtimes\win-x86\native\WebView2Loader.dll"
          DestinationFolder="$(ProjectDir)Clarion\accessory\bin"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)runtimes\win-x86\native\WebView2Loader.dll')" />
  </Target>

  <!-- Build TypeScript frontend before the .NET build.
       Inputs/Outputs enables incremental: only runs when app.ts changes.
       DesignTimeBuild guard prevents VS IntelliSense builds from invoking npm. -->
  <Target Name="BuildFrontend" BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(ProjectDir)frontend\src\app.ts"
          Outputs="$(ProjectDir)wwwroot\controls\generickanban\app.js">
    <Exec Command="npm ci"
          WorkingDirectory="$(ProjectDir)frontend"
          Condition="!Exists('$(ProjectDir)frontend\node_modules')" />
    <Exec Command="npm run build"
          WorkingDirectory="$(ProjectDir)frontend" />
  </Target>

  <Target Name="CopyWwwrootToClarion" AfterTargets="CopyDependenciesToClarion">
    <MakeDir Directories="$(ProjectDir)Clarion\accessory\resources\wwwroot"
             Condition="!Exists('$(ProjectDir)Clarion\accessory\resources\wwwroot')" />
    <ItemGroup>
      <WwwrootFiles Include="$(ProjectDir)wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)"
          DestinationFolder="$(ProjectDir)Clarion\accessory\resources\wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Message Text="Copied wwwroot to Clarion\accessory\resources\wwwroot" Importance="high" />
  </Target>



</Project>
